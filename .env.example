# Copia este archivo como .env y pega tu clave.
# Se usa solo en el servidor de desarrollo, nunca llega al navegador.
ANTHROPIC_API_KEY=sk-ant-...

# Anuncios (Google AdSense). Estos SÍ llegan al navegador (no son secretos).
# Déjalos vacíos y no se muestra ningún anuncio. Ver "Monetización" en el README.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_PLANIFICADOR=
